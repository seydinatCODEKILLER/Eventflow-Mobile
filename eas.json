{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-prod": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "https://event-flow-backend-jph7.onrender.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://event-flow-backend-jph7.onrender.com/api"
      },
      "channel": "preview"
    },
    "production": {
      "env": {
        "API_URL": "https://event-flow-backend-jph7.onrender.com/api"
      },
      "channel": "production"
    }
  }
}